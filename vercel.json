{
  "buildCommand": "npm run build && node scripts/version-assets.mjs --in-place",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "niezwykle-grzyby-polski.vercel.app"
        }
      ],
      "destination": "https://www.atlas-osobliwosci.pl/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "atlas-osobliwosci.vercel.app"
        }
      ],
      "destination": "https://www.atlas-osobliwosci.pl/:path*",
      "permanent": true
    },
    {
      "source": "/atlas/ryby/murowy-swiecik",
      "destination": "/atlas/ryby",
      "permanent": true
    },
    {
      "source": "/en/atlas/ryby/murowy-swiecik",
      "destination": "/en/atlas/ryby",
      "permanent": true
    },
    {
      "source": "/atlas/ryby/lis-morski",
      "destination": "/atlas/ryby",
      "permanent": true
    },
    {
      "source": "/en/atlas/ryby/lis-morski",
      "destination": "/en/atlas/ryby",
      "permanent": true
    },
    {
      "source": "/atlas/formacje-skalne/zezow-czarne-dzialy",
      "destination": "/atlas/formacje-skalne",
      "permanent": true
    },
    {
      "source": "/en/atlas/formacje-skalne/zezow-czarne-dzialy",
      "destination": "/en/atlas/formacje-skalne",
      "permanent": true
    },
    {
      "source": "/atlas/skamienialosci/tholodus-schmidi",
      "destination": "/atlas/skamienialosci",
      "permanent": true
    },
    {
      "source": "/en/atlas/skamienialosci/tholodus-schmidi",
      "destination": "/en/atlas/skamienialosci",
      "permanent": true
    },
    {
      "source": "/atlas/architektura-drewniana/chata-na-wysokosci",
      "destination": "/atlas/architektura-drewniana",
      "permanent": true
    },
    {
      "source": "/en/atlas/architektura-drewniana/chata-na-wysokosci",
      "destination": "/en/atlas/architektura-drewniana",
      "permanent": true
    },
    {
      "source": "/atlas/atmosfera-astronomia/rekord-godziszow-zadni-gerlach",
      "destination": "/atlas/atmosfera-astronomia",
      "permanent": true
    },
    {
      "source": "/en/atlas/atmosfera-astronomia/rekord-godziszow-zadni-gerlach",
      "destination": "/en/atlas/atmosfera-astronomia",
      "permanent": true
    },
    {
      "source": "/atlas/mineraly/berylokordieryt-na",
      "destination": "/atlas/mineraly",
      "permanent": true
    },
    {
      "source": "/en/atlas/mineraly/berylokordieryt-na",
      "destination": "/en/atlas/mineraly",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://*.wikimedia.org; font-src 'self'; connect-src https://tiles.openfreemap.org; child-src blob:; frame-src 'none'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
